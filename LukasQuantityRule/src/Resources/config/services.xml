<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="LukasQuantityRule\Core\Cart\LukasLineItemPayloadEnricher"
                 class="LukasQuantityRule\Core\Cart\LukasLineItemPayloadEnricher"
                 public="true">
            <argument type="service" id="product.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="LukasQuantityRule\Core\Rule\LukasQuantityPairRule"
                 class="LukasQuantityRule\Core\Rule\LukasQuantityPairRule"
                 public="true">
            <tag name="shopware.rule.definition"/>
        </service>

        <service id="LukasQuantityRule\Core\Rule\LukasQuantityPairRuleC"
                 class="LukasQuantityRule\Core\Rule\LukasQuantityPairRuleC"
                 public="true">
            <tag name="shopware.rule.definition"/>
        </service>

        <service id="LukasQuantityRule\Cms\KonfiguratorCmsElementResolver"
                 class="LukasQuantityRule\Cms\KonfiguratorCmsElementResolver"
                 public="true">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="language.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="LukasQuantityRule\Subscriber\CartLineItemSubscriber"
                 class="LukasQuantityRule\Subscriber\CartLineItemSubscriber"
                 public="true">
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="LukasQuantityRule\Subscriber\KonfiguratorProductSubscriber"
                 class="LukasQuantityRule\Subscriber\KonfiguratorProductSubscriber"
                 public="true">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="language.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="LukasQuantityRule\Storefront\Page\Product\Subscriber\ProductPageSubscriber"
                 class="LukasQuantityRule\Storefront\Page\Product\Subscriber\ProductPageSubscriber"
                 public="true">
            <argument type="service" id="product.repository"/>
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="unit.repository"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="LukasQuantityRule\Storefront\Controller\AddToCartController"
                 class="LukasQuantityRule\Storefront\Controller\AddToCartController"
                 public="true">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="product.repository"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>
    </services>
</container>
