{# src/Resources/views/storefront/block/cms-block-lukas-4columns.html.twig #}
<div class="row cms-block-lukas-4columns">
    {% for name in ['column1', 'column2', 'column3', 'column4'] %}
        <div class="col-md-3">
            {% set element = block.slots.getSlot(name) %}
            {% sw_include '@Storefront/storefront/element/cms-element-' ~ element.type ~ '.html.twig' with {
                element: element
            } %}
        </div>
    {% endfor %}
</div>
