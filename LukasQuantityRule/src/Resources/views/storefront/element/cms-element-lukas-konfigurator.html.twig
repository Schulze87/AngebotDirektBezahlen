{% set produkteData = element.data.zubehörProdukte ?? {} %}
{% set p1 = produkteData['10550580'] ?? null %}
{% set p2 = produkteData['10550570'] ?? null %}
{% set p3 = produkteData['10300300'] ?? null %}
{% set p4 = produkteData['10500500'] ?? null %}
{% set p5 = produkteData['10400400'] ?? null %}

{% set productNumber = page.product.productNumber %}
{% set productWidth  = element.data.productWidth ?? null %}
{% set productShrink = element.data.productShrink ?? null %}

{% set isDefaultGroup = context.currentCustomerGroup.id == 'cfbd5018d38d41d8adca10d94fc8bdd6' %}

{% if productWidth and productShrink %}
<div class="lukas-konfigurator"
     id="lukas-konfigurator"
     data-product-number="{{ productNumber }}"
     data-product-name="{{ page.product.name }}"
     data-product-width="{{ productWidth }}"
     data-product-shrink="{{ productShrink }}"
     data-btn-add="{{ 'gewebekonfigurator.btnAdd'|trans }}"
     data-btn-adding="{{ 'gewebekonfigurator.btnAdding'|trans }}"
     data-is-default-group="{{ isDefaultGroup ? 'true' : 'false' }}"
     data-lukas-shaken="{{ page.product.customFields.custom_lukas_shaken ? 'true' : 'false' }}">

    <button type="button" class="btn btn-secondary w-100 text-start" id="lukas-toggle">
        {{ 'gewebekonfigurator.headline'|trans }} ▼
    </button>

    <div id="lukas-konfigurator-body" style="display:none;">

        <div class="form-group mt-3">
            <label for="lukas-anzahl">{{ 'gewebekonfigurator.anzahl.gewebebahnen'|trans }}</label>
            <input type="number" id="lukas-anzahl" class="form-control" min="1" value="1"/>
        </div>

        <div class="form-group mt-3">
            <label for="lukas-laenge">{{ 'gewebekonfigurator.laenge.gewebebahnen'|trans }}</label>
            <input type="number" id="lukas-laenge" class="form-control" min="0.1" step="0.1" value="1"/>
        </div>

        <div class="form-group mt-3">
            <label>{{ 'gewebekonfigurator.optionA'|trans }}</label><br>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="lukas-option-a" id="lukas-option-a1" value="10550580" checked/>
                <label class="form-check-label" for="lukas-option-a1">
                    {{ p1 ? p1.name : '10550580' }}
                </label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="lukas-option-a" id="lukas-option-a2" value="10550570"/>
                <label class="form-check-label" for="lukas-option-a2">
                    {{ p2 ? p2.name : '10550570' }}
                </label>
            </div>
        </div>

        <div class="form-group mt-3">
            <label>{{ 'gewebekonfigurator.optionB'|trans }}</label><br>

            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="lukas-option-b1" value="10300300"/>
                <label class="form-check-label" for="lukas-option-b1">
                    {{ p3 ? p3.name : '10300300' }}
                </label>
            </div>

            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" id="lukas-option-b2" value="10500500"/>
                <label class="form-check-label" for="lukas-option-b2">
                    {{ p4 ? p4.name : '10500500' }}
                </label>
            </div>

            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" id="lukas-option-b3" value="10400400"/>
                <label class="form-check-label" for="lukas-option-b3">
                    {{ p5 ? p5.name : '10400400' }}
                </label>
            </div>
        </div>

        <div class="mt-3">
            <p>
                {{ 'gewebekonfigurator.gewebemenge'|trans }}:
                <strong id="lukas-menge-display">–</strong>
                {{ 'gewebekonfigurator.einheit.gewebe'|trans }}
            </p>
            <p>
                {{ 'gewebekonfigurator.mengeA'|trans }}:
                <strong id="lukas-zusatz-display">–</strong>
                {{ 'gewebekonfigurator.einheit.optionA'|trans }}
            </p>
            <p id="lukas-optionb1-row" style="display:none;">
                {{ p3 ? p3.name : '10300300' }}:
                <strong id="lukas-optionb1-menge">–</strong>
                {{ 'gewebekonfigurator.einheit.optionB'|trans }}
            </p>
            <p id="lukas-optionb2-row" style="display:none;">
                {{ p4 ? p4.name : '10500500' }}:
                <strong id="lukas-optionb2-menge">–</strong>
                {{ 'gewebekonfigurator.einheit.optionB'|trans }}
            </p>
            <p id="lukas-optionb3-row" style="display:none;">
                {{ p5 ? p5.name : '10400400' }}:
                <strong id="lukas-optionb3-menge">–</strong>
                {{ 'gewebekonfigurator.einheit.optionC'|trans }}
            </p>
        </div>

        {% if not isDefaultGroup %}

            <button type="button" class="btn btn-primary mt-3" id="lukas-add-to-cart" disabled>
                {{ 'gewebekonfigurator.btnAdd'|trans }}
            </button>

            <div id="lukas-error" class="alert alert-danger mt-3" style="display:none;">
                {{ 'gewebekonfigurator.error'|trans }}
            </div>

        {% else %}

            <a id="lukas-kontakt-link"
               href="/de/widgets/cms/4f0ea7a59bdf4731983c001a0acfd4e8"
               data-ajax-modal="true"
               data-url="/de/widgets/cms/4f0ea7a59bdf4731983c001a0acfd4e8"
               style="display:none;">
            </a>

            <button type="button" class="btn btn-warning mt-3" id="lukas-kontakt-btn" disabled>
                {{ 'gewebekonfigurator.anfrage'|trans }}
            </button>

        {% endif %}

        <div class="mt-3 text-muted">
            {{ 'gewebekonfigurator.hint'|trans }}
        </div>

    </div>
</div>
{% endif %}
